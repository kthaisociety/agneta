# agneta's local settings: `cp .env.example .env` (git-ignored). Every setting comes from the environment (docs/pcr/0005).

HOST=127.0.0.1
PORT=8003

# local postgres, compose only
POSTGRES_USER=agneta
POSTGRES_PASSWORD=agneta
POSTGRES_DB=agneta

# goose CLI, local only. Deployed, the app gets DATABASE_URL and runs its embedded migrations on start.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://agneta:agneta@localhost:5437/agneta?sslmode=disable
GOOSE_MIGRATION_DIR=internal/db/migrations

# Sign-in. true skips it and ignores everything below; local work only, never staging or production.
AUTH_DISABLED=true

# Where Claude reaches agneta, no trailing slash.
PUBLIC_URL=https://agneta-staging.example.com
# identity-service: public URL (browser redirects) and internal URL (token exchange, keys).
IDENTITY_ISSUER=https://identity-staging.example.com
IDENTITY_INTERNAL_URL=http://identity-service:8000
# agneta's client at identity-service. The secret lives in OpenBao, never in the repo.
IDENTITY_CLIENT_ID=agneta
IDENTITY_CLIENT_SECRET=
