# agneta's local settings: `cp .env.example .env` (git-ignored). Every setting comes from the environment (docs/pcr/0005).

HOST=127.0.0.1
PORT=8003

# local postgres, compose only
POSTGRES_USER=agneta
POSTGRES_PASSWORD=agneta
POSTGRES_DB=agneta

# goose CLI, for local migrations
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://agneta:agneta@localhost:5432/agneta?sslmode=disable
GOOSE_MIGRATION_DIR=internal/db/migrations
